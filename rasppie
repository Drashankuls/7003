import requests
import pytz
import csv
import os
import threading
import time
from datetime import datetime
from concurrent.futures import ThreadPoolExecutor

# ---------------------------------------------------------
# YOUR STOCK LIST (add as many as you want)
# ---------------------------------------------------------
symbols = [
    "AAPL", "TSLA", "MSFT", "AMZN",
    "NVDA", "GOOG", "META", "NFLX",
    "AMD", "INTC", "ORCL"
]

pst = pytz.timezone("America/Los_Angeles")

# ---------------------------------------------------------
# CSV SETUP
# ---------------------------------------------------------
CSV_FILE = "data_log.csv"

if not os.path.exists(CSV_FILE):
    with open(CSV_FILE, "w", newline="") as f:
        writer = csv.writer(f)
        writer.writerow([
            "timestamp", "symbol",
            "ask_robinhood", "bid_robinhood", "last_robinhood",
            "price_yahoo", "price_nasdaq"
        ])

# ---------------------------------------------------------
# FETCH FUNCTIONS
# ---------------------------------------------------------

def fetch_yahoo(symbol):
    url = "https://query1.finance.yahoo.com/v7/finance/quote?symbols={}".format(symbol)
    try:
        data = requests.get(url, timeout=2).json()
        return data["quoteResponse"]["result"][0].get("regularMarketPrice")
    except:
        return None

def fetch_nasdaq(symbol):
    url = "https://api.nasdaq.com/api/quote/{}/info?assetclass=stocks".format(symbol)
    headers = {"User-Agent": "Mozilla/5.0"}
    try:
        data = requests.get(url, headers=headers, timeout=2).json()
        price_str = data["data"]["primaryData"]["lastSalePrice"]
        return float(price_str.replace("$", ""))
    except:
        return None

# ---------------------------------------------------------
# BACKGROUND LOGGER (runs every 2 seconds)
# ---------------------------------------------------------

def background_logger():
    pool = ThreadPoolExecutor(max_workers=20)

    while True:
        now = datetime.now(pst)

        # Robinhood batch request
        url = "https://api.robinhood.com/quotes/?symbols=" + ",".join(symbols)
        try:
            rh_data = requests.get(url, timeout=3).json().get("results", [])
        except:
            rh_data = []

        # Prepare async Yahoo/Nasdaq fetches
        futures = {}
        for item in rh_data:
            symbol = item.get("symbol")
            futures[symbol] = {
                "yahoo": pool.submit(fetch_yahoo, symbol),
                "nasdaq": pool.submit(fetch_nasdaq, symbol)
            }

        # Process results + write CSV
        for item in rh_data:
            symbol = item.get("symbol")

            ask_raw = item.get("ask_price")
            bid_raw = item.get("bid_price")
            last_raw = item.get("last_trade_price")

            ask = float(ask_raw) if ask_raw else None
            bid = float(bid_raw) if bid_raw else None
            last = float(last_raw) if last_raw else None

            yahoo_price = futures[symbol]["yahoo"].result()
            nasdaq_price = futures[symbol]["nasdaq"].result()

            with open(CSV_FILE, "a", newline="") as f:
                writer = csv.writer(f)
                writer.writerow([
                    now.strftime("%Y-%m-%d %H:%M:%S"),
                    symbol,
                    ask, bid, last,
                    yahoo_price,
                    nasdaq_price
                ])

        time.sleep(2)

# ---------------------------------------------------------
# START LOGGER
# ---------------------------------------------------------

if __name__ == "__main__":
    print("Starting stock logger...")
    t = threading.Thread(target=background_logger, daemon=True)
    t.start()

    # Keep main thread alive
    while True:
        time.sleep(1)

